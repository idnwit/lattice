{
  "$schema": "lattice-tokens/v0.1",
  "name": "lattice",
  "version": "0.1.0",
  "color": {
    "bg/0": { "value": "#0A0C0D", "use": "App ground, terminal" },
    "bg/1": { "value": "#101315", "use": "Panels, title bar, status bar" },
    "bg/2": { "value": "#161A1D", "use": "Hover, inputs, raised" },
    "bg/3": { "value": "#1D2226", "use": "Selected row, active tab" },
    "line": { "value": "#22282C", "use": "Dividers, pane gutters" },
    "line/subtle": { "value": "#1A1F22", "use": "Row separators inside a list" },
    "line/strong": { "value": "#2E353A", "use": "Control borders, overlays" },
    "fg": { "value": "#E4E7E9", "use": "Primary text, output" },
    "fg/term": { "value": "#C9CED2", "use": "Terminal body text, unselected rows" },
    "fg/muted": { "value": "#9AA3A9", "use": "Labels, secondary" },
    "fg/dim": { "value": "#838C93", "use": "Meta, hints (>= 4.5:1 on bg/0)" },
    "fg/faint": { "value": "#4A5359", "use": "Line numbers, disabled marks. Never body text" },
    "accent": { "value": "#5CC8E8", "use": "Focus, cursor, primary action" },
    "accent/hover": { "value": "#8FDCF2", "use": "Link hover" },
    "accent/ink": { "value": "#04161C", "use": "Text on accent fill" },
    "accent/border": { "value": "#23414B", "use": "Port chip border" }
  },
  "accentOptions": ["#5CC8E8", "#E8A33D", "#9BE36B", "#B48CFF"],
  "state": {
    "online": { "value": "#46C46E", "shape": "dot", "use": "Worker reachable, direct P2P" },
    "relay": { "value": "#46C46E", "shape": "ring", "use": "Reachable via relay" },
    "agent": { "value": "#B48CFF", "shape": "diamond", "use": "Agent running" },
    "waiting": { "value": "#E8A33D", "shape": "bar", "use": "Needs input or approval" },
    "error": { "value": "#F26D6D", "shape": "square", "use": "Exit != 0, link lost" },
    "offline": { "value": "#6B747B", "shape": "ring-dim", "use": "Worker asleep" },
    "idle": { "value": "#838C93", "shape": "ring", "use": "Agent idle" },
    "rtt/good": { "value": "#46C46E", "shape": "bars-3", "unfilled": "fg/dim outline", "use": "Relay RTT < 50 ms (proposed threshold)" },
    "rtt/fair": { "unfilled": "fg/dim outline", "value": "#E8C15A", "shape": "bars-2", "use": "Relay RTT 50-150 ms (proposed thresholds)" },
    "rtt/poor": { "unfilled": "fg/dim outline", "value": "#F26D6D", "shape": "bars-1", "use": "Relay RTT > 150 ms (proposed threshold)" },
    "rtt/down": { "unfilled": "fg/dim outline", "value": "#F26D6D", "shape": "bars-0-cross", "use": "Relay down or unregistered" }
  },
  "tint": {
    "agent/bg": { "value": "#1C1729", "use": "Agent chip fill" },
    "agent/fg": { "value": "#CFB4FF", "use": "Agent name text" },
    "waiting/bg": { "value": "#17130C", "use": "Row waiting for approval" },
    "danger/bg": { "value": "#1F1414", "use": "Destructive button fill" },
    "danger/border": { "value": "#5A2E2E", "use": "Destructive button border" },
    "diff/modified": { "value": "#E8C15A", "use": "Git M" },
    "diff/added": { "value": "#46C46E", "use": "Git A" },
    "diff/deleted": { "value": "#F26D6D", "use": "Git D" }
  },
  "ansi": ["#1D2226", "#F26D6D", "#46C46E", "#E8C15A", "#5C9DFF", "#B48CFF", "#5CC8E8", "#C9CED2",
           "#4A5359", "#FF9494", "#7BDC97", "#F5D88A", "#8CB9FF", "#CFB4FF", "#8FDCF2", "#F4F6F7"],
  "font": {
    "sans": "Inter, system-ui, sans-serif",
    "mono": "'JetBrains Mono', 'Symbols Nerd Font Mono', ui-monospace, monospace"
  },
  "type": {
    "title": { "font": "sans", "size": 20, "line": 28, "weight": 600 },
    "heading": { "font": "sans", "size": 14, "line": 20, "weight": 600 },
    "body": { "font": "sans", "size": 13, "line": 18, "weight": 400 },
    "label": { "font": "sans", "size": 11, "line": 16, "weight": 600, "tracking": "0.08em", "case": "upper" },
    "mono/term": { "font": "mono", "size": 13, "line": 20, "weight": 400 },
    "mono/ui": { "font": "mono", "size": 12, "line": 16, "weight": 500 },
    "mono/meta": { "font": "mono", "size": 11, "line": 14, "weight": 400 }
  },
  "space": { "sp/1": 4, "sp/2": 8, "sp/3": 12, "sp/4": 16, "sp/6": 24, "sp/8": 32, "sp/12": 48 },
  "row": { "row/xs": 22, "row/sm": 28, "row/md": 32, "row/key": 40, "row/touch": 44 },
  "radius": { "r/0": 0, "r/3": 3, "r/6": 6, "r/12": 12 },
  "shadow": { "overlay": "0 8px 24px #000a" },
  "focus": { "pane": "inset 0 0 0 1px {accent}", "tab": "inset 0 2px 0 {accent}", "toolTab": "inset 0 -2px 0 {accent}", "row": "inset 2px 0 0 {accent}" },
  "motion": { "hover": 80, "split": 120, "sheet": 200, "terminal": 0 },
  "icon": { "grid": 16, "stroke": 1.5, "color": "currentColor" }
}
